# Copy to .env and fill in values. Never commit .env.
# Generate a strong encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---- Core ----
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public

# ---- Redis (queues / caching / rate limits) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---- Token encryption at rest (AES-256-GCM key, base64, 32 bytes) ----
TOKEN_ENCRYPTION_KEY=change-me-base64-32-byte-key

# ---- SMTP (Mailpit in dev: http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pulse <noreply@pulse.local>

# ---- S3-compatible storage (MinIO in dev: http://localhost:9001 console) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pulse-media
S3_ACCESS_KEY=pulse
S3_SECRET_KEY=pulse-minio-secret
S3_FORCE_PATH_STYLE=true

# ---- Social platforms: OAuth app credentials (register each in its developer console) ----

# Meta (Facebook + Instagram) — https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_APP_VERSION=v26.0
# Meta webhooks (Pages/IG/WhatsApp): any opaque string you choose; must match
# the value entered in the Meta app dashboard (App -> webhook -> Verify token).
META_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify

# WhatsApp Business Cloud API (no OAuth — permanent app token + phone number id;
# connect validates the pair against the Graph API):
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-whatsapp-webhook-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Composer "publish" target (E.164 digits, e.g. 919876543210) — WhatsApp has no
# public feed, so the publish action sends the message to this recipient.
WHATSAPP_PUBLISH_TO=

# X / Twitter — https://developer.x.com/en/portal
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# YouTube (Google Cloud) — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform feature flags (no credentials registered yet -> provider runs in dry-run mode)
META_ENABLED=true
X_ENABLED=true
LINKEDIN_ENABLED=true
YOUTUBE_ENABLED=true
WHATSAPP_ENABLED=false